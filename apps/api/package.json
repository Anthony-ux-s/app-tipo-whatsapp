{
  "name": "@parla/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Parla: NestJS + Prisma (Ports & Adapters)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "node ../../scripts/with-env.mjs prisma generate",
    "db:migrate": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node ../../scripts/with-env.mjs prisma migrate dev",
    "db:seed": "node ../../scripts/with-env.mjs tsx prisma/seed/bootstrap.ts",
    "db:setup": "npm run prisma:generate && npm run db:migrate && npm run db:seed",
    "db:studio": "node ../../scripts/with-env.mjs prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@parla/crypto": "0.1.0",
    "@parla/types": "0.1.0",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/web-push": "^3.6.4",
    "prisma": "~6.19.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
