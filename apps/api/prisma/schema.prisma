// Esquema de Parla (Prisma sobre PostgreSQL de Supabase).
//  - DATABASE_URL: conexión de la app. En Supabase usa el «pooler» (puerto 6543) con `?pgbouncer=true`.
//  - DIRECT_URL: conexión directa (puerto 5432), solo para aplicar las migraciones (`prisma migrate deploy`).
// Los valores de tipo enum se guardan como texto y están tipados en @parla/types.

generator client {
  provider        = "prisma-client-js"
  // relationLoadStrategy: "join" trae las relaciones en UNA consulta (con la base lejos, cada ida y vuelta pesa).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  username        String?   @unique
  phone           String?   @unique
  /// Cuándo se verificó el teléfono con un código por SMS (las cuentas nuevas siempre lo verifican).
  phoneVerifiedAt DateTime?
  /// Correo para restablecer la contraseña; solo cuenta una vez verificado con un código.
  email           String?   @unique
  emailVerifiedAt DateTime?
  /// Foto de perfil (archivo público con nombre impredecible); null = iniciales y color.
  avatarFileId    String?
  displayName     String
  about           String    @default("")
  avatarColor     String
  passwordHash    String
  /// Clave pública ECDH (JWK serializado).
  publicKey       String
  /// Clave privada cifrada con la contraseña (JSON EncryptedKeyBackup).
  keyBackup       String
  /// Preferencias del usuario (JSON UserPreferences).
  preferences     String
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  /// Aceptación de términos y política de privacidad (versión y fecha).
  termsVersion    String?
  termsAcceptedAt DateTime?
  /// Cuenta eliminada: se anonimiza (sin nombre, usuario ni teléfono) y no puede volver a entrar.
  deletedAt       DateTime?
  /// Soporte de Parla: aprueba repartidores y resuelve reclamos.
  isAdmin         Boolean   @default(false)
  /// Suspendida por soporte: no puede entrar ni usar la app (motivo visible para soporte).
  blockedAt       DateTime?
  blockedReason   String?

  participants      ConversationParticipant[]
  wrappedKeys       ConversationParticipant[] @relation("WrappedBy")
  messages          Message[]
  receipts          MessageReceipt[]
  mentions          MessageMention[]
  pushSubscriptions PushSubscription[]
  orders            Order[]
  savedAddresses    SavedAddress[]
  /// Negocio del que es dueño (atiende pedidos de un servicio); null para los clientes.
  business          Business?
  /// Perfil de repartidor de Rapidito; null si no reparte.
  driver            Driver?
  activity          UserActivityDay[]
  rouletteSpins     RouletteSpin[]
  searchEvents      SearchEvent[]
}

model Conversation {
  id          String   @id @default(cuid())
  /// ConversationKind: direct | group
  kind        String
  title       String   @default("")
  description String   @default("")
  avatarColor String
  /// Evita chats individuales duplicados: "<usuarioA>:<usuarioB>" ordenado.
  directKey   String?  @unique
  createdById String
  createdAt   DateTime @default(now())
  /// Última actividad: ordena la lista de chats.
  updatedAt   DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
  files        StoredFile[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id               String   @id @default(cuid())
  conversationId   String
  userId           String
  /// Clave de la conversación envuelta para este usuario (base64).
  wrappedKey       String
  keyIv            String
  wrappedById      String
  /// Clave pública de quien envolvió, tal como era al envolver: si después cambia sus claves
  /// (restablece su cuenta), esta copia se sigue pudiendo abrir.
  wrapperPublicKey String   @default("")
  joinedAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wrappedBy    User         @relation("WrappedBy", fields: [wrappedById], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  /// MessageKind: text | image | audio | video | system
  kind           String
  ciphertext     String?
  iv             String?
  /// JSON MediaAttachment (metadatos; el archivo va cifrado en el almacenamiento).
  media          String?
  systemText     String?
  /// Id generado por el cliente: hace idempotente el reenvío.
  clientId       String
  /// Hilo: mensaje raíz al que responde (siempre la raíz, los hilos no se anidan).
  replyToId      String?
  createdAt      DateTime @default(now())

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receipts     MessageReceipt[]
  replyTo      Message?         @relation("Thread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]        @relation("Thread")
  mentions     MessageMention[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([replyToId])
}

/// Personas mencionadas con @ en un mensaje. El texto va cifrado; solo se conoce a quién se menciona.
model MessageMention {
  messageId      String
  userId         String
  conversationId String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, conversationId])
}

/// Suscripción Web Push de un navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Un recibo por destinatario: guarda cuándo se entregó y cuándo se leyó.
model MessageReceipt {
  messageId      String
  userId         String
  conversationId String
  deliveredAt    DateTime?
  readAt         DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, readAt])
  @@index([userId, deliveredAt])
}

model StoredFile {
  id             String   @id @default(cuid())
  conversationId String
  uploaderId     String
  size           Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// Pedido hecho desde Servicios (tienda + delivery + pago con QR). Lo arma el gateway (Go) con
/// precios de la tienda y la tarifa del delivery; el core lo guarda y avisa cada cambio al cliente y al negocio.
model Order {
  /// Id generado por el gateway ("ord_…").
  id                   String    @id
  userId               String
  /// ServiceId: mercado | salud
  service              String
  /// OrderStatus: pending_payment | paid | preparing | rejected | searching_driver | driver_assigned | on_the_way | delivered | payment_expired | cancelled
  status               String
  /// JSON OrderLine[]
  lines                String
  subtotalCents        Int
  deliveryFeeCents     Int
  /// Propina para el repartidor (incluida en totalCents).
  tipCents             Int       @default(0)
  /// Descuento del cupón (ya restado de totalCents) y su código.
  discountCents        Int       @default(0)
  couponCode           String?
  totalCents           Int
  currency             String
  /// JSON DeliveryAddress
  address              String
  /// JSON OrderPayment (QR, URL de pago, vencimiento, fecha de pago)
  payment              String
  /// Cotización de Rapidito con la que se calculó la tarifa de delivery.
  deliveryQuoteId      String
  /// Minutos que Rapidito estimó para el envío (para la hora estimada de llegada).
  etaMinutes           Int       @default(30)
  /// JSON OrderDelivery (repartidor, vehículo, tiempo estimado); null hasta que un repartidor lo toma.
  delivery             String?
  /// Negocio que prepara el pedido; null en pedidos sin negocio asignado.
  businessId           String?
  /// Dónde se recoge (la ubicación de la tienda al crear el pedido): si la tienda se muda, el
  /// historial de entregas no cambia. null en pedidos viejos o sin ubicación.
  pickupLat            Float?
  pickupLng            Float?
  /// Repartidor de Rapidito que lo tomó; null mientras nadie lo toma.
  driverId             String?
  /// Código de entrega de 4 dígitos (solo lo ve el cliente); el repartidor lo pide al entregar.
  deliveryCode         String
  /// Intentos fallidos del código: al quinto se bloquea la entrega con código.
  deliveryCodeAttempts Int       @default(0)
  /// Ofertas por cercanía: radio actual (km desde la tienda; null = todos los repartidores) y
  /// desde cuándo, para ampliarlo por oleadas.
  offerRadiusKm        Float?
  offerWaveAt          DateTime?
  /// Asignación óptima: el pedido se reserva un rato para el repartidor elegido (offerDriverId) hasta
  /// offerUntil; con offerDriverId null y offerUntil puesto, se retiene mientras se calcula a quién darlo.
  offerDriverId        String?
  offerUntil           DateTime?
  /// Foto de la entrega (opcional con código; obligatoria si se dejó sin código, p. ej. en portería).
  deliveryPhotoId      String?
  deliveredWithoutCode Boolean   @default(false)
  /// Calificación del cliente al recibirlo (1 a 5), al repartidor y a la tienda.
  driverStars          Int?
  storeStars           Int?
  ratingComment        String    @default("")
  ratedAt              DateTime?
  /// JSON OrderTimelineEntry[]: cada paso con su hora (constancia para cliente y negocio).
  timeline             String    @default("[]")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  claims   Claim[]
  driver   Driver?           @relation(fields: [driverId], references: [userId], onDelete: SetNull)
  coupon   CouponRedemption?

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@index([driverId, createdAt])
  @@index([status, createdAt])
}

/**
 * Tienda de Parla (marketplace): la registra su dueño desde la app y soporte la aprueba. Vende desde el
 * catálogo propio de Parla (source = native, tabla Product) o desde su propia API (source = api). El
 * dueño acepta cada pedido, lo prepara, avisa cuando está listo y se lo entrega al repartidor.
 */
model Business {
  id              String   @id @default(cuid())
  name            String
  /// Categoría: mercado | tecnologia | ferreteria | salud (varias tiendas por categoría).
  service         String
  description     String   @default("")
  ownerId         String   @unique
  /// Dirección donde el repartidor recoge los pedidos, y su punto en el mapa.
  address         String
  lat             Float?
  lng             Float?
  /// StoreStatus: pending | approved | rejected | suspended. Solo las aprobadas venden.
  status          String   @default("pending")
  /// Motivo del rechazo o la suspensión (lo escribe soporte).
  reviewNote      String   @default("")
  reviewedAt      DateTime?
  reviewedById    String?
  /// De dónde sale su catálogo: native (tabla Product) | api (su propio sistema).
  source          String   @default("native")
  /// API propia (source = api): idioma (parla | redwiiil), URL, ruta y claves. Nunca se devuelven completas.
  apiFormat       String   @default("parla")
  apiBaseUrl      String   @default("")
  apiPrefix       String   @default("")
  apiKey          String   @default("")
  apiAdminKey     String   @default("")
  /// El dueño puede pausar los pedidos aunque esté en horario («Recibir pedidos»).
  acceptingOrders Boolean  @default(true)
  /// Horario de atención (hora de Lima, «HH:MM»); si cierra antes de abrir, cruza la medianoche.
  opensAt         String   @default("08:00")
  closesAt        String   @default("22:00")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orders       Order[]
  products     Product[]
  reservations StockReservation[]

  @@index([service, status])
  @@index([status, createdAt])
}

/// Producto del catálogo propio de una tienda (source = native). Precios en céntimos.
model Product {
  id             String   @id @default(cuid())
  businessId     String
  /// Código propio de la tienda (único dentro de la tienda).
  sku            String
  name           String
  /// Presentación: «1 kg», «750 ml»…
  unit           String   @default("")
  priceCents     Int
  /// Precio normal cuando está en oferta (priceCents es el rebajado).
  listPriceCents Int?
  stock          Int      @default(0)
  category       String   @default("")
  imageUrl       String?
  /// Los inactivos no se muestran a los clientes.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, sku])
  @@index([businessId, category])
}

/// Stock apartado para un pedido (referencia = id del pedido): hace la reserva idempotente y permite devolverla.
model StockReservation {
  businessId String
  reference  String
  /// JSON [{ sku, quantity }]
  lines      String
  released   Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, reference])
}

/// Repartidor de Rapidito: una cuenta de Parla con su vehículo. Toma los pedidos listos, los recoge
/// en la tienda y los entrega con el código del cliente.
model Driver {
  userId          String    @id
  /// Tipo de vehículo («Moto», «Bicicleta»…).
  vehicle         String
  plate           String
  /// Conectado: recibe ofertas y puede tomar pedidos.
  online          Boolean   @default(false)
  /// Dejó de repartir: no recibe nada, pero sus entregas quedan en el historial.
  active          Boolean   @default(true)
  /// Número de PagaYa donde se le depositan sus ganancias (9 dígitos).
  payoutPhone     String?
  /// Verificación (como Rappi o PedidosYa): pending (en revisión) | approved | rejected.
  status          String    @default("pending")
  dniNumber       String?
  licenseNumber   String?
  /// Foto del documento (privada: solo la ven el repartidor y soporte).
  documentPhotoId String?
  /// Motivo del rechazo (o nota de soporte) y cuándo se revisó.
  reviewNote      String?
  reviewedAt      DateTime?
  /// Última ubicación que mandó su celular (solo mientras reparte).
  lastLat         Float?
  lastLng         Float?
  lastLocationAt  DateTime?
  createdAt       DateTime  @default(now())

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
  ledger DriverLedgerEntry[]
}

/// Movimientos del saldo del repartidor. Por cada entrega: + tarifa, − comisión de Rapidito (5 %) y
/// + propina; por cada depósito: − monto (pendiente mientras se transfiere; si falla, deja de contar).
/// El saldo es la suma de los movimientos que no fallaron.
model DriverLedgerEntry {
  /// Los depósitos usan «po_…» como id (es la referencia de la transferencia en PagaYa).
  id            String    @id @default(cuid())
  driverId      String
  /// Pedido de la entrega; null en los depósitos.
  orderId       String?
  /// delivery_fee | commission | tip | payout
  kind          String
  /// En céntimos, con signo: positivo suma al saldo, negativo resta.
  amountCents   Int
  /// posted (cuenta) | pending | paid | failed (depósitos)
  status        String    @default("posted")
  transferId    String?
  failureReason String?
  /// manual | auto (depósitos)
  reason        String?
  createdAt     DateTime  @default(now())
  settledAt     DateTime?

  driver Driver @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  /// Una entrega se anota una sola vez aunque el aviso se repita.
  @@unique([orderId, kind])
  @@index([driverId, createdAt])
}

/**
 * Código de verificación de un solo uso (SMS al registrarse; correo al agregarlo o para restablecer la
 * contraseña). Solo se guarda el hash del código. Al verificarse entrega un comprobante de un solo uso.
 */
model VerificationCode {
  id         String    @id @default(cuid())
  /// VerificationChannel: sms | email
  channel    String
  /// VerificationPurpose: register | email | reset_password
  purpose    String
  /// Teléfono E.164 o correo en minúsculas.
  target     String
  /// Cuenta que lo pidió (agregar correo); null al registrarse.
  userId     String?
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  /// Hash del comprobante que se entrega al verificar (para registrarse o restablecer).
  proofHash  String?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, purpose, createdAt])
}

/// Foto subida por una persona (documento del repartidor, foto de entrega o de un reclamo). Privada:
/// se sirve solo a quien participa en el pedido o a soporte; solo su dueño puede adjuntarla.
model UploadedPhoto {
  id         String   @id
  uploaderId String
  createdAt  DateTime @default(now())

  @@index([uploaderId])
}

/// Reclamo de un pedido entregado (como en Rappi): faltó algo, llegó mal o no llegó. Soporte lo
/// resuelve con una devolución parcial (vía gateway y PagaYa) o lo rechaza.
model Claim {
  id               String    @id @default(cuid())
  orderId          String
  userId           String
  /// missing_items | damaged | wrong_items | not_delivered | other
  reason           String
  comment          String    @default("")
  /// JSON ClaimItem[]: productos y cantidades afectadas.
  items            String    @default("[]")
  photoId          String?
  /// Devolución sugerida (lo que costaron los productos marcados).
  suggestedCents   Int
  /// open | refunding | refunded | rejected
  status           String    @default("open")
  refundCents      Int?
  /// Referencia de la devolución en PagaYa («rf_…»), para que no se devuelva dos veces.
  refundRef        String?
  providerRefundId String?
  resolutionNote   String    @default("")
  resolvedById     String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([orderId])
}

/// Dirección de entrega guardada (como «Casa» o «Trabajo» en Rappi). Se recuerda sola al pedir; la
/// persona le pone nombre o la borra.
model SavedAddress {
  id         String   @id @default(cuid())
  userId     String
  /// Nombre opcional: «Casa», «Trabajo»…
  label      String   @default("")
  line       String
  reference  String   @default("")
  lat        Float?
  lng        Float?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, line])
  @@index([userId, lastUsedAt])
}

/// Cupón de descuento o envío gratis (lo crea soporte). Los usos que cuentan son los de pedidos que
/// siguen vivos o se entregaron: si el pedido se cancela o vence, el cupón vuelve a quedar libre.
model Coupon {
  /// El código que escribe el cliente, en mayúsculas («BIENVENIDA»).
  code             String    @id
  description      String
  /// percent | amount | free_delivery
  kind             String
  /// Porcentaje (1 a 100) o céntimos de descuento; 0 en envío gratis.
  value            Int       @default(0)
  /// Tope del descuento en porcentaje (null = sin tope).
  maxDiscountCents Int?
  /// Compra mínima en productos.
  minSubtotalCents Int       @default(0)
  /// Solo para el primer pedido de la persona.
  firstOrderOnly   Boolean   @default(false)
  /// Usos por persona y en total (null = sin límite total).
  perUserLimit     Int       @default(1)
  maxUses          Int?
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean   @default(true)
  /// Cupón personal (lo ganó en la ruleta): solo esa persona puede usarlo. null = lo puede usar cualquiera.
  ownerUserId      String?
  createdAt        DateTime  @default(now())

  redemptions CouponRedemption[]

  @@index([ownerUserId])
}

/// Un cupón usado en un pedido (uno por pedido).
model CouponRedemption {
  id            String   @id @default(cuid())
  couponCode    String
  userId        String
  orderId       String   @unique
  discountCents Int
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponCode], references: [code], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponCode])
  @@index([userId])
}

/// Tarifa del delivery que configura soporte (una sola fila, id «default»; JSON DeliveryPricing).
model DeliverySettings {
  id          String   @id @default("default")
  pricing     String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Tráfico: cuántas veces abrió la app cada persona por día (hora de Lima), para el panel de soporte.
model UserActivityDay {
  userId String
  /// AAAA-MM-DD
  day    String
  visits Int    @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}
/// Ruleta de descuentos: a quién le sale (segment), cada cuánto puede girar y los premios (JSON RoulettePrize[]).
model RouletteCampaign {
  id           String   @id @default(cuid())
  name         String
  title        String
  subtitle     String   @default("")
  /// CustomerSegment: vip | loyal | lapsed | never_bought | new | all
  segment      String
  cooldownDays Int      @default(1)
  prizes       String
  enabled      Boolean  @default(false)
  /// Estrategia: roulette | scratch | box | flash
  kind         String   @default("roulette")
  /// Ventana en la que está activa (null = sin límite). La oferta relámpago siempre lleva `endsAt`.
  startsAt     DateTime?
  endsAt       DateTime?
  /// Modo de prueba: se muestra cada vez que la persona entra y los giros no gastan su turno.
  testMode     Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  spins RouletteSpin[]

  @@index([enabled, segment])
}

/// Un giro. El premio lo elige el servidor; `slot` (período de espera) impide girar dos veces a la vez.
model RouletteSpin {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  slot       Int
  prizeId    String
  prizeLabel String
  /// Cupón personal creado por el premio; null si no ganó nada.
  couponCode String?
  createdAt  DateTime @default(now())

  campaign RouletteCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId, slot])
  @@index([campaignId, createdAt])
}

/// Lo que buscó cada persona en las tiendas (para ordenar sus ofertas y ver tendencias en soporte).
model SearchEvent {
  id        String   @id @default(cuid())
  userId    String
  service   String
  term      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}
