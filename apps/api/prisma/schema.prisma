// Esquema de Parla. En desarrollo usa SQLite embebida; para producción
// `npm run db:postgres-schema` genera la variante PostgreSQL de este mismo archivo.
// Los valores de tipo enum se guardan como texto y están tipados en @parla/types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String?   @unique
  phone        String?   @unique
  displayName  String
  about        String    @default("")
  avatarColor  String
  passwordHash String
  /// Clave pública ECDH (JWK serializado).
  publicKey    String
  /// Clave privada cifrada con la contraseña (JSON EncryptedKeyBackup).
  keyBackup    String
  /// Preferencias del usuario (JSON UserPreferences).
  preferences  String
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  /// Aceptación de términos y política de privacidad (versión y fecha).
  termsVersion    String?
  termsAcceptedAt DateTime?
  /// Cuenta eliminada: se anonimiza (sin nombre, usuario ni teléfono) y no puede volver a entrar.
  deletedAt       DateTime?

  memberships  WorkspaceMember[]
  participants ConversationParticipant[]
  wrappedKeys  ConversationParticipant[] @relation("WrappedBy")
  messages     Message[]
  receipts     MessageReceipt[]
  mentions     MessageMention[]
  pushSubscriptions PushSubscription[]
}

model Workspace {
  id                String   @id @default(cuid())
  name              String
  description       String   @default("")
  color             String
  inviteCode        String   @unique
  allowMemberGroups Boolean  @default(true)
  /// PlanId: free | team | business. Vale hasta planExpiresAt; después rige el plan gratuito.
  plan              String    @default("free")
  planExpiresAt     DateTime?
  payments          Payment[]
  creatorId         String
  createdAt         DateTime @default(now())

  members       WorkspaceMember[]
  conversations Conversation[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  /// WorkspaceRole: admin | member
  role        String
  joinedAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  /// ConversationKind: direct | group
  kind        String
  title       String   @default("")
  description String   @default("")
  avatarColor String
  /// Evita chats individuales duplicados: "<workspace>:<usuarioA>:<usuarioB>" ordenado.
  directKey   String?  @unique
  createdById String
  createdAt   DateTime @default(now())
  /// Última actividad: ordena la lista de chats.
  updatedAt   DateTime @default(now())

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  files        StoredFile[]
  tasks        Task[]

  @@index([workspaceId, updatedAt])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  /// Clave de la conversación envuelta para este usuario (base64).
  wrappedKey     String
  keyIv          String
  wrappedById    String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wrappedBy    User         @relation("WrappedBy", fields: [wrappedById], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  /// MessageKind: text | image | audio | video | system
  kind           String
  ciphertext     String?
  iv             String?
  /// JSON MediaAttachment (metadatos; el archivo va cifrado en el almacenamiento).
  media          String?
  systemText     String?
  /// Id generado por el cliente: hace idempotente el reenvío.
  clientId       String
  /// Hilo: mensaje raíz al que responde (siempre la raíz, los hilos no se anidan).
  replyToId      String?
  /// Tarea que presenta este mensaje (kind = task).
  taskId         String?  @unique
  createdAt      DateTime @default(now())

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receipts     MessageReceipt[]
  replyTo      Message?         @relation("Thread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]        @relation("Thread")
  mentions     MessageMention[]
  task         Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([replyToId])
}

/// Personas mencionadas con @ en un mensaje. El texto va cifrado; solo se conoce a quién se menciona.
model MessageMention {
  messageId      String
  userId         String
  conversationId String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, conversationId])
}

/// Tarea asignable dentro de un chat. El título va cifrado con la clave de la conversación.
model Task {
  id              String    @id @default(cuid())
  conversationId  String
  workspaceId     String
  titleCiphertext String
  titleIv         String
  assigneeId      String?
  createdById     String
  /// Fecha límite (AAAA-MM-DD), sin hora.
  dueDate         String?
  /// TaskStatus: open | done
  status          String    @default("open")
  sourceMessageId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  completedById   String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?

  @@index([conversationId, status])
  @@index([workspaceId, assigneeId, status])
  @@index([workspaceId, createdById])
}

/// Suscripción Web Push de un navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Un recibo por destinatario: guarda cuándo se entregó y cuándo se leyó.
model MessageReceipt {
  messageId      String
  userId         String
  conversationId String
  deliveredAt    DateTime?
  readAt         DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, readAt])
  @@index([userId, deliveredAt])
}

model StoredFile {
  id             String   @id @default(cuid())
  conversationId String
  uploaderId     String
  size           Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// Pago de un plan (un mes prepagado). Sirve de historial y de comprobante.
model Payment {
  id          String    @id @default(cuid())
  workspaceId String
  /// Quién inició el pago (administrador del espacio).
  createdById String
  /// PlanId pagado: team | business
  plan        String
  /// Importe en la unidad de la moneda (COP sin decimales).
  amount      Int
  currency    String
  /// PaymentStatus: pending | approved | rejected
  status      String    @default("pending")
  /// PaymentProvider: sandbox | mercadopago
  provider    String
  providerRef String?
  checkoutUrl String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
