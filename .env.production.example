# Copia este archivo a .env.production y completa los valores (no lo subas al repositorio).
PUBLIC_URL=https://chat.miempresa.com
POSTGRES_PASSWORD=cambia-esta-clave-larga
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Clave entre servicios (gateway, core y tiempo real); genera otra con el mismo comando
INTERNAL_TOKEN=
# OneSignal: códigos de verificación por SMS (registro) y correo (recuperar la cuenta). Obligatorio.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_SMS_FROM=
# Firma de los avisos de la billetera (PagaYa) al gateway; 24+ caracteres
PAGAYA_WEBHOOK_SECRET=
# Clave de la API de administración de la tienda (MercaYa): con ella la dueña cambia precios, ofertas y stock; 24+ caracteres
MERCAYA_ADMIN_KEY=
# Clave de las transferencias de la billetera (PagaYa): con ella se pagan las ganancias a los repartidores; 24+ caracteres
PAGAYA_API_KEY=
# Hora de Lima del retiro automático diario a los repartidores (HH:MM); vacío lo apaga
RAPIDITO_PAYOUT_AT=23:00
# URL pública de la página de pago de la billetera simulada (lo que abre el QR)
PROVIDERS_PUBLIC_URL=https://pagos.miempresa.com
# Notificaciones push: genera con  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# TURN opcional para llamadas en redes corporativas muy cerradas (p. ej. coturn propio)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Ganancias del repartidor de Rapidito: porcentaje de la tarifa de delivery que gana (de 50 a 100;
# Rapidito se queda con el resto; la propina siempre va completa al repartidor) y mínimos en soles
# para el depósito automático diario y para «Retirar ahora»
DRIVER_SHARE_PERCENT=95
DRIVER_MIN_AUTO_PAYOUT_SOLES=5
DRIVER_MIN_MANUAL_PAYOUT_SOLES=1
# Ofertas por cercanía (como Rappi): un pedido listo se ofrece primero a los repartidores a menos de
# 3 km de la tienda, a los 2 minutos sin tomarse a 6 km, luego a 12 km y al final a todos
DISPATCH_RADII_KM=3,6,12
DISPATCH_WAVE_MINUTES=2
