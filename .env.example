# ═════════════════════════════════════════════════════════════════════════════════════════════
#  PARLA · variables de entorno
#
#  1) Copia este archivo:      cp .env.example .env        (en Windows: copy .env.example .env)
#  2) Completa los valores de abajo (NO subas el .env al repositorio: ya está en .gitignore).
#  3) Con Docker:              docker compose up -d --build
#     Sin Docker (esta PC):    npm run start:prod
#
#  Un solo archivo sirve para todo: la API, el gateway, el tiempo real, Prisma y Docker lo leen.
#  Lo marcado como (OBLIGATORIO) debe tener valor; el resto tiene un valor por defecto razonable.
#  Para generar un secreto largo:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ═════════════════════════════════════════════════════════════════════════════════════════════


# ── 1. BASE DE DATOS · Supabase (PostgreSQL) con Prisma ──────────────────────────────────────
# En Supabase: Project Settings → Database → Connection string.
#
# DATABASE_URL (OBLIGATORIO): conexión de la app, por el "pooler" (puerto 6543, modo Transaction).
#   Importante: lleva  ?pgbouncer=true  al final (y &connection_limit=10 si lo necesitas).
#   Ejemplo: postgresql://postgres.abcdefghijk:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# DIRECT_URL (OBLIGATORIO): conexión directa (puerto 5432), solo para aplicar las migraciones de Prisma.
#   Ejemplo: postgresql://postgres.abcdefghijk:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=


# ── 2. DIRECCIÓN PÚBLICA ─────────────────────────────────────────────────────────────────────
# Dominio sin https:// que Caddy publica con HTTPS automático (Docker). Mismo que PUBLIC_URL.
SITE_ADDRESS=kronito.com
# URL con la que la gente abre la app (con https). La cámara, el micrófono, las notificaciones push,
# la instalación como app (PWA) y el APK exigen HTTPS. (OBLIGATORIO en producción)
PUBLIC_URL=https://chat.tudominio.com
# Origen(es) permitidos por CORS, separados por coma. Normalmente igual a PUBLIC_URL.
WEB_ORIGIN=https://chat.tudominio.com
# Solo para la billetera SIMULADA (PagaYa) de desarrollo: la página de pago que abre su QR. No hace falta
# en producción: los pagos reales irán con una pasarela (Culqi o Mercado Pago) y su SDK, sin dominio propio.
PROVIDERS_PUBLIC_URL=
# Puerto público del gateway cuando usas `npm run start:prod` (sin Docker).
PARLA_GATEWAY_PORT=4100


# ── 3. SECRETOS · genéralos tú, cada uno distinto ────────────────────────────────────────────
# Firma de las sesiones (32+ caracteres). (OBLIGATORIO)
JWT_SECRET=
# Clave entre servicios: gateway, core y tiempo real (24+ caracteres). (OBLIGATORIO)
INTERNAL_TOKEN=
# Firma de los avisos de la billetera (PagaYa) hacia el gateway (24+ caracteres). (OBLIGATORIO)
PAGAYA_WEBHOOK_SECRET=
# Clave de las transferencias de la billetera: con ella se pagan las ganancias a los repartidores (24+). (OBLIGATORIO)
PAGAYA_API_KEY=
# Clave de la API de administración de la tienda (MercaYa): la dueña cambia precios, ofertas y stock (24+). (OBLIGATORIO)
MERCAYA_ADMIN_KEY=
# Duración de la sesión.
JWT_EXPIRES_IN=7d


# ── 4. PRIMER ADMINISTRADOR · se crea con `npm run db:seed` (se puede repetir sin duplicar) ──
# No hay usuarios ni datos de ejemplo: esta es la cuenta con la que entras al panel «Administración».
ADMIN_USERNAME=
# 8+ caracteres con letras y números. Protege también la clave de cifrado de la cuenta.
ADMIN_PASSWORD=
ADMIN_NAME=Soporte
# Opcional (formato +51999999999): también podrás entrar con el teléfono.
ADMIN_PHONE=



# ── 5. CÓDIGOS POR SMS Y CORREO · OneSignal (https://onesignal.com) ──────────────────────────
# (OBLIGATORIO en producción: sin esto el registro y la recuperación de cuenta no funcionan)
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Opcional: número emisor E.164 o Messaging Service ID de Twilio que envía los SMS.
ONESIGNAL_SMS_FROM=


# ── 5b. SMS CON FIREBASE (más simple que OneSignal/Twilio: Google manda el SMS, sin comprar números) ───
# Si lo llenas, el registro usa Firebase Authentication; si lo dejas vacío, usa OneSignal. Guía: docs/FIREBASE.md
# Backend: solo el id del proyecto (se valida el resultado de Firebase con las claves públicas de Google).
FIREBASE_PROJECT_ID=
# Web: son datos PÚBLICOS de la app web de Firebase. Van en Vercel (Settings → Environment Variables), no aquí:
#   VITE_FIREBASE_API_KEY=   VITE_FIREBASE_PROJECT_ID=   VITE_FIREBASE_APP_ID=   VITE_FIREBASE_AUTH_DOMAIN=


# ── 6. NOTIFICACIONES PUSH · Web Push ────────────────────────────────────────────────────────
# Genera el par con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com


# ── 7. LLAMADAS (WebRTC) ─────────────────────────────────────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN opcional para redes corporativas muy cerradas (p. ej. coturn propio).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=


# ── 8. DELIVERY (RAPIDITO) ───────────────────────────────────────────────────────────────────
# Rutas por las calles para cotizar el envío. En producción conviene un OSRM propio
# (el servidor público de abajo es solo de demostración y tiene límites). Vacío = línea recta × factor de calles.
ROUTING_URL=https://router.project-osrm.org
# Hora de Lima del retiro automático diario a los repartidores (HH:MM); vacío lo apaga.
RAPIDITO_PAYOUT_AT=23:00
# Porcentaje de la tarifa de delivery que gana el repartidor (50 a 100); la propina va completa.
DRIVER_SHARE_PERCENT=95
# Mínimos en soles para el depósito automático diario y para «Retirar ahora».
DRIVER_MIN_AUTO_PAYOUT_SOLES=5
DRIVER_MIN_MANUAL_PAYOUT_SOLES=1
# Ofertas por cercanía: radios (km) de cada oleada y minutos antes de ampliar el radio.
DISPATCH_RADII_KM=3,6,12
DISPATCH_WAVE_MINUTES=2
# Vigilancia de entregas: cada cuánto se revisa (ms; 0 la apaga) y minutos para volver a ofrecer un pedido
# sin repartidor, reasignar si no lo recogió o si su celular dejó de mandar ubicación.
DELIVERY_WATCH_INTERVAL_MS=60000
DELIVERY_UNTAKEN_MINUTES=5
DELIVERY_PICKUP_MINUTES=25
DELIVERY_SILENT_MINUTES=8


# ── 9. TIENDAS DE PRUEBA (simuladores) ───────────────────────────────────────────────────────
# Clave de la tienda de tecnología simulada (TecnoYa). La URL y la clave de cada tienda REAL se
# configuran desde Administración → Integrar, no aquí.
TECNOYA_API_KEY=
# Peticiones por minuto que acepta el gateway por IP.
GATEWAY_RATE_PER_MINUTE=600


# ── 10. ARCHIVOS SUBIDOS (ya cifrados) ───────────────────────────────────────────────────────
# Carpeta donde se guardan. Con Docker es un volumen (/data/storage): no la cambies.
STORAGE_DIR=./storage


# ── 11. APP ANDROID (APK) · solo para generarla, ver docs/apk/LEEME.md ───────────────────────
# Dominio donde está publicada la app (sin https://). Debe coincidir con PUBLIC_URL.
APK_HOST=chat.tudominio.com
# Identificador único de la app en Android (no se puede cambiar después de publicarla).
APK_PACKAGE_ID=com.tudominio.parla
# Huella SHA-256 de la firma del APK (la da Bubblewrap/PWABuilder al generarla; varias, separadas por coma).
# Con esto la propia API publica https://tu-dominio/.well-known/assetlinks.json (necesario para que la app
# se abra sin barra del navegador). Se llena DESPUÉS de generar el APK: ver docs/apk/LEEME.md.
APK_SHA256_CERT_FINGERPRINTS=
APK_APP_NAME=Parla
# Ruta del archivo de firma (keystore) y sus claves. Guárdalo bien: sin él no podrás actualizar la app.
APK_KEYSTORE_PATH=./android.keystore
APK_KEYSTORE_ALIAS=parla
APK_KEYSTORE_PASSWORD=
APK_KEY_PASSWORD=


# ── 12. SUPABASE · opcional (la app hoy solo necesita DATABASE_URL y DIRECT_URL) ─────────────
# Déjalo vacío salvo que más adelante uses Storage o Auth de Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ── Correo con Brevo (registro y recuperación por correo) · guía: docs/BREVO.md ──────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Parla

# ── Firebase web · «Continuar con Google» y SMS (datos PÚBLICOS de la app web de Firebase) ───
# Los lee Vite al compilar la web (también van en Vercel → Settings → Environment Variables).
# En Firebase: Authentication → Sign-in method → activa «Google» y autoriza tu dominio.
# FIREBASE_PROJECT_ID (arriba) debe ser el mismo proyecto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
