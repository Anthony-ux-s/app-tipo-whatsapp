# Puerto del core (interno: el público es el gateway Go en 4100). 3000, 3005 y 4317 están ocupados en esta PC
PORT=4101
# Origen permitido para CORS (la web)
WEB_ORIGIN=http://localhost:3100
# Desarrollo: SQLite embebida. Producción: postgresql://usuario:clave@host:5432/parla
DATABASE_URL="file:./dev.db"
# Cambia este secreto en producción
JWT_SECRET=parla-dev-secret-cambiar-en-produccion
JWT_EXPIRES_IN=7d
# Carpeta donde se guardan los archivos (ya cifrados)
STORAGE_DIR=./storage
# Notificaciones push (Web Push). Si se dejan vacías, se generan solas en STORAGE_DIR/vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@parla.app
# URL pública de la web (producción): enlaces de las notificaciones y lectura automática del SMS
PUBLIC_WEB_URL=
# Códigos de verificación por SMS y correo con OneSignal (https://onesignal.com).
# Vacío en desarrollo = modo de prueba: el código sale en pantalla y en la consola.
# El SMS necesita un número emisor (Twilio) configurado en el panel de OneSignal.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Opcional: número E.164 o Messaging Service ID de Twilio que envía los SMS
ONESIGNAL_SMS_FROM=
# Llamadas WebRTC: STUN públicos gratuitos; TURN opcional para redes muy restrictivas
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Producción en un solo proceso: la API sirve la web compilada
WEB_DIST=
# Servicio de tiempo real (Elixir) y token compartido entre servicios internos (gateway, core, realtime)
REALTIME_URL=http://localhost:4102
INTERNAL_TOKEN=parla-dev-internal-token
