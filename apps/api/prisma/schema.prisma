// Esquema de Parla. En desarrollo usa SQLite embebida; para producción
// `npm run db:postgres-schema` genera la variante PostgreSQL de este mismo archivo.
// Los valores de tipo enum se guardan como texto y están tipados en @parla/types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String?   @unique
  phone        String?   @unique
  displayName  String
  about        String    @default("")
  avatarColor  String
  passwordHash String
  /// Clave pública ECDH (JWK serializado).
  publicKey    String
  /// Clave privada cifrada con la contraseña (JSON EncryptedKeyBackup).
  keyBackup    String
  /// Preferencias del usuario (JSON UserPreferences).
  preferences  String
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  /// Aceptación de términos y política de privacidad (versión y fecha).
  termsVersion    String?
  termsAcceptedAt DateTime?
  /// Cuenta eliminada: se anonimiza (sin nombre, usuario ni teléfono) y no puede volver a entrar.
  deletedAt       DateTime?

  participants ConversationParticipant[]
  wrappedKeys  ConversationParticipant[] @relation("WrappedBy")
  messages     Message[]
  receipts     MessageReceipt[]
  mentions     MessageMention[]
  pushSubscriptions PushSubscription[]
  orders       Order[]
}

model Conversation {
  id          String   @id @default(cuid())
  /// ConversationKind: direct | group
  kind        String
  title       String   @default("")
  description String   @default("")
  avatarColor String
  /// Evita chats individuales duplicados: "<usuarioA>:<usuarioB>" ordenado.
  directKey   String?  @unique
  createdById String
  createdAt   DateTime @default(now())
  /// Última actividad: ordena la lista de chats.
  updatedAt   DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
  files        StoredFile[]
  tasks        Task[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  /// Clave de la conversación envuelta para este usuario (base64).
  wrappedKey     String
  keyIv          String
  wrappedById    String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wrappedBy    User         @relation("WrappedBy", fields: [wrappedById], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  /// MessageKind: text | image | audio | video | system
  kind           String
  ciphertext     String?
  iv             String?
  /// JSON MediaAttachment (metadatos; el archivo va cifrado en el almacenamiento).
  media          String?
  systemText     String?
  /// Id generado por el cliente: hace idempotente el reenvío.
  clientId       String
  /// Hilo: mensaje raíz al que responde (siempre la raíz, los hilos no se anidan).
  replyToId      String?
  /// Tarea que presenta este mensaje (kind = task).
  taskId         String?  @unique
  createdAt      DateTime @default(now())

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receipts     MessageReceipt[]
  replyTo      Message?         @relation("Thread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]        @relation("Thread")
  mentions     MessageMention[]
  task         Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([replyToId])
}

/// Personas mencionadas con @ en un mensaje. El texto va cifrado; solo se conoce a quién se menciona.
model MessageMention {
  messageId      String
  userId         String
  conversationId String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, conversationId])
}

/// Tarea asignable dentro de un chat. El título va cifrado con la clave de la conversación.
model Task {
  id              String    @id @default(cuid())
  conversationId  String
  titleCiphertext String
  titleIv         String
  assigneeId      String?
  createdById     String
  /// Fecha límite (AAAA-MM-DD), sin hora.
  dueDate         String?
  /// TaskStatus: open | done
  status          String    @default("open")
  sourceMessageId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  completedById   String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?

  @@index([conversationId, status])
  @@index([assigneeId, status])
  @@index([createdById])
}

/// Suscripción Web Push de un navegador.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Un recibo por destinatario: guarda cuándo se entregó y cuándo se leyó.
model MessageReceipt {
  messageId      String
  userId         String
  conversationId String
  deliveredAt    DateTime?
  readAt         DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, readAt])
  @@index([userId, deliveredAt])
}

model StoredFile {
  id             String   @id @default(cuid())
  conversationId String
  uploaderId     String
  size           Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// Pedido hecho desde Servicios (tienda + delivery + pago con QR). Lo arma el gateway (Go) con
/// precios de la tienda y la tarifa del delivery; el core lo guarda y avisa cada cambio al cliente.
model Order {
  /// Id generado por el gateway ("ord_…").
  id               String   @id
  userId           String
  /// ServiceId: mercado | salud
  service          String
  /// OrderStatus: pending_payment | paid | searching_driver | on_the_way | delivered | payment_expired | cancelled
  status           String
  /// JSON OrderLine[]
  lines            String
  subtotalCents    Int
  deliveryFeeCents Int
  totalCents       Int
  currency         String
  /// JSON DeliveryAddress
  address          String
  /// JSON OrderPayment (QR, URL de pago, vencimiento, fecha de pago)
  payment          String
  /// Cotización del delivery que se despacha al confirmarse el pago.
  deliveryQuoteId  String
  /// JSON OrderDelivery (motorizado, vehículo, tiempo estimado); null hasta despacharlo.
  delivery         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
