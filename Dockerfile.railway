# Parla TODO EN UNO (para Railway y plataformas parecidas): un solo contenedor con los cuatro programas del
# backend, que se hablan por 127.0.0.1 (sin red interna entre servicios):
#   gateway (Go)     → única puerta pública, escucha en $PORT (lo pone la plataforma)
#   core (NestJS)    → API y base de datos (Supabase), puerto 4101
#   tiempo real (Elixir) → chats y llamadas por WebSocket, puerto 4102
#   simuladores (Go) → billetera, delivery y tienda de prueba, puerto 4103
# La web NO va aquí: está en Vercel. La base de datos es Supabase (DATABASE_URL y DIRECT_URL).
# Para docker-compose en un VPS se sigue usando el Dockerfile normal (un contenedor por programa).

# ── Gateway y simuladores (Go) ───────────────────────────────────────────────────────────────
FROM golang:1.25-bookworm AS go-build
WORKDIR /src
COPY services/gateway/go.mod services/gateway/go.sum gateway/
RUN cd gateway && go mod download
COPY services/gateway gateway
COPY services/providers providers
RUN cd gateway && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gateway ./cmd/gateway \
  && cd ../providers && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/providers ./cmd/providers

# ── Tiempo real (Elixir): release de OTP ─────────────────────────────────────────────────────
FROM elixir:1.18-otp-27-slim AS realtime-build
ENV MIX_ENV=prod
WORKDIR /src
RUN mix local.hex --force && mix local.rebar --force
COPY services/realtime/mix.exs services/realtime/mix.lock ./
COPY services/realtime/config config
RUN mix deps.get --only prod && mix deps.compile
COPY services/realtime/lib lib
RUN mix release

# ── Core (NestJS + Prisma) ───────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS core-build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY packages/types/package.json packages/types/
COPY packages/crypto/package.json packages/crypto/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY packages packages
COPY apps/api apps/api
RUN npm run build:packages \
  && npx prisma generate --schema apps/api/prisma/schema.prisma \
  && npm run build -w @parla/api

# ── Imagen final ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini openssl ca-certificates libstdc++6 libncurses6 locales curl \
  && rm -rf /var/lib/apt/lists/* \
  && sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && locale-gen \
  && useradd --create-home --uid 10001 parla \
  && mkdir -p /data/storage && chown -R parla /data
ENV LANG=en_US.UTF-8 NODE_ENV=production STORAGE_DIR=/data/storage RELEASE_TMP=/tmp/realtime

COPY --from=go-build /out/gateway /usr/local/bin/gateway
COPY --from=go-build /out/providers /usr/local/bin/providers
COPY --from=realtime-build --chown=parla /src/_build/prod/rel/parla_realtime /opt/realtime
COPY --from=core-build --chown=parla /app /app
COPY docker/railway-entry.sh docker/railway-run.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/railway-entry.sh /usr/local/bin/railway-run.sh

# Los archivos subidos (ya cifrados) viven en /data/storage: monta ahí un volumen para no perderlos.
VOLUME ["/data"]
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s CMD curl -fs "http://127.0.0.1:${PORT:-4100}/gateway/health" || exit 1
# Arranca como root solo para dar permiso al volumen, y enseguida baja a un usuario sin privilegios.
ENTRYPOINT ["tini", "--", "/usr/local/bin/railway-entry.sh"]
