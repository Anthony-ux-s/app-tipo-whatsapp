{
  "name": "@parla/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Parla: NestJS + Prisma (Ports & Adapters)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:setup": "prisma generate && prisma db push --skip-generate --accept-data-loss && tsx prisma/seed/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx prisma/seed/seed.ts --force",
    "db:postgres-schema": "node prisma/make-postgres-schema.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@parla/crypto": "0.1.0",
    "@parla/types": "0.1.0",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "prisma": "~6.19.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
